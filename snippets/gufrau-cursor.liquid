{%- comment -%}
  Lagging blue moon cursor for GUFRAU pages.
  Desktop + fine pointer only; disabled for reduced motion.
{%- endcomment -%}

<div class="gufrau-cursor" data-gufrau-cursor aria-hidden="true">
  <span class="gufrau-cursor__moon" data-gufrau-cursor-ring></span>
</div>

<script src="{{ 'gufrau-cursor.js' | asset_url }}" defer></script>

{% stylesheet %}
  .gufrau-cursor {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    transition: opacity 220ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .gufrau-cursor.is-visible {
    opacity: 1;
  }

  .gufrau-cursor__moon {
    position: fixed;
    top: 0;
    left: 0;
    width: 24px;
    height: 24px;
    border: 0;
    border-radius: 50%;
    background: #0000ff;
    box-shadow: inset -7px 0 0 0 #fff;
    will-change: transform;
    transform: translate3d(-100px, -100px, 0) translate(-50%, -50%) rotate(-20deg);
  }

  .gufrau-cursor.is-hover .gufrau-cursor__moon {
    box-shadow: inset -6px 0 0 0 #fff;
  }

  @media (hover: none), (pointer: coarse) {
    .gufrau-cursor {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gufrau-cursor {
      display: none;
    }
  }
{% endstylesheet %}
