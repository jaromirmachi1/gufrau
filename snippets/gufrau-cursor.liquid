{%- comment -%}
  Awwwards-style lagging cursor chase for GUFRAU pages.
  Desktop + fine pointer only; disabled for reduced motion.
{%- endcomment -%}

<div class="gufrau-cursor" data-gufrau-cursor aria-hidden="true">
  <span class="gufrau-cursor__ghost" data-gufrau-cursor-ghost></span>
  <span class="gufrau-cursor__mid" data-gufrau-cursor-mid></span>
  <span class="gufrau-cursor__ring" data-gufrau-cursor-ring></span>
</div>

<script src="{{ 'gufrau-cursor.js' | asset_url }}" defer></script>

{% stylesheet %}
  .gufrau-cursor {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    transition: opacity 220ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .gufrau-cursor.is-visible {
    opacity: 1;
  }

  .gufrau-cursor__ring,
  .gufrau-cursor__mid,
  .gufrau-cursor__ghost {
    position: fixed;
    top: 0;
    left: 0;
    border-radius: 50%;
    will-change: transform;
    transform: translate3d(-100px, -100px, 0) translate(-50%, -50%);
  }

  .gufrau-cursor__ring {
    width: 18px;
    height: 18px;
    border: 1.5px solid #111;
    background: transparent;
  }

  .gufrau-cursor__mid {
    width: 6px;
    height: 6px;
    background: #111;
  }

  .gufrau-cursor__ghost {
    width: 42px;
    height: 42px;
    border: 1px solid rgba(17, 17, 17, 0.28);
    background: rgba(17, 17, 17, 0.04);
  }

  .gufrau-cursor.is-hover .gufrau-cursor__ring {
    border-color: #111;
  }

  .gufrau-cursor.is-hover .gufrau-cursor__ghost {
    background: rgba(17, 17, 17, 0.07);
  }

  @media (hover: none), (pointer: coarse) {
    .gufrau-cursor {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gufrau-cursor {
      display: none;
    }
  }
{% endstylesheet %}
