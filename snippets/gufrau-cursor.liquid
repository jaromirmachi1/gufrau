{%- comment -%}
  Simple lagging cursor circle for GUFRAU pages.
  Desktop + fine pointer only; disabled for reduced motion.
{%- endcomment -%}

<div class="gufrau-cursor" data-gufrau-cursor aria-hidden="true">
  <span class="gufrau-cursor__ring" data-gufrau-cursor-ring></span>
</div>

<script src="{{ 'gufrau-cursor.js' | asset_url }}" defer></script>

{% stylesheet %}
  .gufrau-cursor {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    transition: opacity 220ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .gufrau-cursor.is-visible {
    opacity: 1;
  }

  .gufrau-cursor__ring {
    position: fixed;
    top: 0;
    left: 0;
    width: 22px;
    height: 22px;
    border: 1.5px solid #0000ff;
    border-radius: 50%;
    background: transparent;
    will-change: transform;
    transform: translate3d(-100px, -100px, 0) translate(-50%, -50%);
  }

  @media (hover: none), (pointer: coarse) {
    .gufrau-cursor {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gufrau-cursor {
      display: none;
    }
  }
{% endstylesheet %}
