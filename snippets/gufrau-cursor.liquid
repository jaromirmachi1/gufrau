{%- comment -%}
  Sitewide Splash Cursor (reactbits fluid simulation).
  Desktop + fine pointer only; disabled for reduced motion.
{%- endcomment -%}

<div class="gufrau-cursor" data-gufrau-cursor aria-hidden="true">
  <canvas class="gufrau-cursor__canvas" data-gufrau-cursor-canvas></canvas>
</div>

<script src="{{ 'gufrau-cursor.js' | asset_url }}" defer></script>

{% stylesheet %}
  .gufrau-cursor {
    position: fixed;
    inset: 0;
    z-index: 9998;
    pointer-events: none;
    opacity: 0;
    transition: opacity 280ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .gufrau-cursor.is-visible {
    opacity: 1;
  }

  .gufrau-cursor__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (hover: none), (pointer: coarse) {
    .gufrau-cursor {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gufrau-cursor {
      display: none;
    }
  }
{% endstylesheet %}
