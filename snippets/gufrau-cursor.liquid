{%- comment -%}
  Soft blue chase blob for GUFRAU pages.
  Desktop + fine pointer only; disabled for reduced motion.
{%- endcomment -%}

<div class="gufrau-cursor" data-gufrau-cursor aria-hidden="true">
  <span class="gufrau-cursor__blob" data-gufrau-cursor-ring></span>
</div>

<script src="{{ 'gufrau-cursor.js' | asset_url }}" defer></script>

{% stylesheet %}
  .gufrau-cursor {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0;
    transition: opacity 220ms cubic-bezier(0.23, 1, 0.32, 1);
  }

  .gufrau-cursor.is-visible {
    opacity: 1;
  }

  .gufrau-cursor__blob {
    position: fixed;
    top: 0;
    left: 0;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, rgba(80, 80, 255, 0.55), rgba(0, 0, 255, 0.28) 55%, rgba(0, 0, 255, 0) 72%);
    filter: blur(2px);
    mix-blend-mode: multiply;
    will-change: transform;
    transform: translate3d(-100px, -100px, 0) translate(-50%, -50%);
  }

  .gufrau-cursor.is-hover .gufrau-cursor__blob {
    background: radial-gradient(circle at 35% 30%, rgba(80, 80, 255, 0.7), rgba(0, 0, 255, 0.38) 55%, rgba(0, 0, 255, 0) 72%);
  }

  @media (hover: none), (pointer: coarse) {
    .gufrau-cursor {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gufrau-cursor {
      display: none;
    }
  }
{% endstylesheet %}
