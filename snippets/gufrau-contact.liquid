{% liquid
  assign logo_image = section.settings.logo
  assign text_color = section.settings.text_color | default: '#0B1F7A'
  assign booking_label = section.settings.booking_label | default: 'Booking'
  assign booking_email = section.settings.booking_email | default: 'booking@gufrau.com'
  assign management_label = section.settings.management_label | default: 'Management'
  assign management_email = section.settings.management_email | default: 'management@gufrau.com'
  assign seller_label = section.settings.seller_label | default: 'Provozovatel e-shopu'
  assign company_name = section.settings.company_name
  assign company_address = section.settings.company_address
  assign company_ico = section.settings.company_ico
  assign company_dic = section.settings.company_dic
  assign shop_email = section.settings.shop_email
  assign shop_phone = section.settings.shop_phone
  assign legal_label = section.settings.legal_label | default: 'Právní informace'
%}

<section
  class="gufrau-contact"
  style="--gufrau-contact-text: {{ text_color }};"
  {{ section.shopify_attributes }}
>
  <a class="gufrau-contact__home" href="{{ routes.root_url }}">home</a>

  <div class="gufrau-contact__content">
    <div class="gufrau-contact__block">
      <h1 class="gufrau-contact__label">{{ booking_label | escape }}</h1>
      <a class="gufrau-contact__email" href="mailto:{{ booking_email | escape }}">
        {{ booking_email | escape }}
      </a>
    </div>

    <div class="gufrau-contact__block">
      <h2 class="gufrau-contact__label">{{ management_label | escape }}</h2>
      <a class="gufrau-contact__email" href="mailto:{{ management_email | escape }}">
        {{ management_email | escape }}
      </a>
    </div>

    <div class="gufrau-contact__block gufrau-contact__block--seller">
      <h2 class="gufrau-contact__label">{{ seller_label | escape }}</h2>
      <div class="gufrau-contact__seller">
        {%- if company_name != blank -%}
          <p>{{ company_name | escape }}</p>
        {%- else -%}
          <p class="gufrau-contact__placeholder">[DOPLŇTE obchodní firmu / jméno]</p>
        {%- endif -%}
        {%- if company_address != blank -%}
          <p>{{ company_address | escape | newline_to_br }}</p>
        {%- else -%}
          <p class="gufrau-contact__placeholder">[DOPLŇTE sídlo / adresu]</p>
        {%- endif -%}
        {%- if company_ico != blank -%}
          <p>IČO: {{ company_ico | escape }}</p>
        {%- else -%}
          <p class="gufrau-contact__placeholder">IČO: [DOPLŇTE]</p>
        {%- endif -%}
        {%- if company_dic != blank -%}
          <p>DIČ: {{ company_dic | escape }}</p>
        {%- endif -%}
        {%- if shop_email != blank -%}
          <p>
            <a class="gufrau-contact__email gufrau-contact__email--inline" href="mailto:{{ shop_email | escape }}">
              {{ shop_email | escape }}
            </a>
          </p>
        {%- endif -%}
        {%- if shop_phone != blank -%}
          <p>
            <a class="gufrau-contact__email gufrau-contact__email--inline" href="tel:{{ shop_phone | escape | replace: ' ', '' }}">
              {{ shop_phone | escape }}
            </a>
          </p>
        {%- endif -%}
      </div>
    </div>

    <nav class="gufrau-contact__block gufrau-contact__legal" aria-label="{{ legal_label | escape }}">
      <h2 class="gufrau-contact__label">{{ legal_label | escape }}</h2>
      <ul class="gufrau-contact__legal-list">
        <li>
          <a class="gufrau-contact__legal-link" href="{% if pages['obchodni-podminky'].url != blank %}{{ pages['obchodni-podminky'].url }}{% else %}/pages/obchodni-podminky{% endif %}">
            Obchodní podmínky
          </a>
        </li>
        <li>
          <a class="gufrau-contact__legal-link" href="{% if pages['reklamacni-rad'].url != blank %}{{ pages['reklamacni-rad'].url }}{% else %}/pages/reklamacni-rad{% endif %}">
            Reklamační řád
          </a>
        </li>
        <li>
          <a class="gufrau-contact__legal-link" href="{% if pages['odstoupeni-od-smlouvy'].url != blank %}{{ pages['odstoupeni-od-smlouvy'].url }}{% else %}/pages/odstoupeni-od-smlouvy{% endif %}">
            Odstoupení od smlouvy
          </a>
        </li>
        <li>
          <a class="gufrau-contact__legal-link" href="{% if pages['ochrana-osobnich-udaju'].url != blank %}{{ pages['ochrana-osobnich-udaju'].url }}{% else %}/pages/ochrana-osobnich-udaju{% endif %}">
            Ochrana osobních údajů
          </a>
        </li>
        <li>
          <a class="gufrau-contact__legal-link" href="{% if pages['cookies'].url != blank %}{{ pages['cookies'].url }}{% else %}/pages/cookies{% endif %}">
            Zásady cookies
          </a>
        </li>
        <li>
          <a class="gufrau-contact__legal-link" href="{% if pages['mimosoudni-reseni-sporu'].url != blank %}{{ pages['mimosoudni-reseni-sporu'].url }}{% else %}/pages/mimosoudni-reseni-sporu{% endif %}">
            Mimosoudní řešení sporů
          </a>
        </li>
      </ul>
    </nav>
  </div>

  <div class="gufrau-contact__logo" aria-hidden="true">
    {%- if logo_image != blank -%}
      {{
        logo_image
        | image_url: width: 2400
        | image_tag:
          class: 'gufrau-contact__logo-img',
          widths: '600, 900, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          alt: ''
      }}
    {%- else -%}
      <img
        class="gufrau-contact__logo-img"
        src="{{ 'blueorange.png' | asset_url }}"
        alt=""
        width="2902"
        height="732"
        loading="eager"
      >
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  body:has(.gufrau-contact) {
    background: #ffffff;
    color: var(--gufrau-contact-text, #0b1f7a);
  }

  body:has(.gufrau-contact) #header-group:empty,
  body:has(.gufrau-contact) footer:has(.shopify-section-group-footer-group:empty) {
    display: none;
  }

  body:has(.gufrau-contact) .content-for-layout {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  body:has(.gufrau-contact) .content-for-layout > .shopify-section:has(.gufrau-contact) {
    flex: 1;
    display: flex;
  }

  .gufrau-contact {
    --gufrau-contact-text: #0b1f7a;
    --gufrau-ease: cubic-bezier(0.23, 1, 0.32, 1);
    position: relative;
    flex: 1;
    width: 100%;
    min-height: 100dvh;
    background: #fff;
    color: var(--gufrau-contact-text);
    isolation: isolate;
    overflow-x: hidden;
    overflow-y: auto;
  }

  .gufrau-contact__home {
    position: absolute;
    top: clamp(1rem, 3vw, 1.75rem);
    left: clamp(1rem, 3vw, 1.75rem);
    z-index: 3;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.7rem 1.45rem;
    background: transparent;
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    text-decoration: none;
    color: #b0b0b0;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
    transition:
      transform 180ms var(--gufrau-ease),
      text-shadow 180ms var(--gufrau-ease),
      color 180ms var(--gufrau-ease),
      letter-spacing 180ms var(--gufrau-ease);
  }

  .gufrau-contact__home:hover {
    color: #7a7a7a;
    transform: translateY(-2px) scale(1.04);
    letter-spacing: 0.07em;
    text-shadow:
      0 6px 16px rgba(0, 0, 0, 0.28),
      0 2px 4px rgba(0, 0, 0, 0.14);
  }

  .gufrau-contact__home:active {
    transform: translateY(0) scale(0.97);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.16);
  }

  .gufrau-contact__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: clamp(1.75rem, 4vh, 2.75rem);
    padding: clamp(5rem, 14vh, 8rem) clamp(1.25rem, 5vw, 3.5rem) 28vh;
    max-width: 42rem;
  }

  .gufrau-contact__block {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .gufrau-contact__label {
    margin: 0;
    font-size: clamp(1.35rem, 2.8vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.15;
  }

  .gufrau-contact__email {
    color: inherit;
    text-decoration: none;
    font-size: clamp(1.05rem, 2.2vw, 1.4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    transition: opacity 180ms var(--gufrau-ease);
  }

  .gufrau-contact__email--inline {
    font-size: inherit;
  }

  .gufrau-contact__email:hover {
    opacity: 0.65;
  }

  .gufrau-contact__seller {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    margin-top: 0.15rem;
    font-size: clamp(0.98rem, 1.8vw, 1.15rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.35;
  }

  .gufrau-contact__seller p {
    margin: 0;
  }

  .gufrau-contact__placeholder {
    opacity: 0.45;
  }

  .gufrau-contact__legal {
    gap: 0.55rem;
  }

  .gufrau-contact__legal-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .gufrau-contact__legal-link {
    color: inherit;
    text-decoration: none;
    font-size: clamp(1rem, 2vw, 1.2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    transition:
      opacity 180ms var(--gufrau-ease),
      transform 180ms var(--gufrau-ease);
    display: inline-block;
  }

  .gufrau-contact__legal-link:hover {
    opacity: 0.65;
    transform: translateX(3px);
  }

  .gufrau-contact__legal-link:active {
    transform: translateX(1px) scale(0.98);
  }

  .gufrau-contact__logo {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    width: 100%;
    margin: 0;
    padding: 0;
    line-height: 0;
    pointer-events: none;
  }

  .gufrau-contact__logo-img {
    transform: translateY(10%);
    display: block;
    width: 105%;
    max-width: none;
    height: auto;
    margin: 0 0 0 -2.5%;
  }

  @media screen and (max-width: 749px) {
    .gufrau-contact__content {
      padding-bottom: 24vh;
    }
  }
{% endstylesheet %}
