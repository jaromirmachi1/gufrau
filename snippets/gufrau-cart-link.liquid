{% comment %}
  Cart link matching GUFRAU nav pills, with item count beside the label.
{% endcomment %}

<a
  class="gufrau-cart-link{% if cart.item_count > 0 %} has-items{% endif %}"
  href="{{ routes.cart_url }}"
  data-gufrau-cart-link
  aria-label="Cart{% if cart.item_count > 0 %}, {{ cart.item_count }} items{% endif %}"
>
  <span class="gufrau-cart-link__label">cart</span>
  <span
    class="gufrau-cart-link__count{% if cart.item_count == 0 %} is-empty{% endif %}"
    data-gufrau-cart-count
    aria-hidden="true"
  >
    {{- cart.item_count -}}
  </span>
</a>

{% stylesheet %}
  .gufrau-cart-link {
    --gufrau-ease: cubic-bezier(0.23, 1, 0.32, 1);
    position: fixed;
    top: clamp(1rem, 3vw, 1.75rem);
    right: clamp(1rem, 3vw, 1.75rem);
    z-index: 5;
    display: inline-flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    height: 2.75rem;
    min-height: 2.75rem;
    padding: 0 1.45rem;
    background: transparent;
    color: #b0b0b0;
    text-decoration: none;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.18);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    line-height: 1;
    transition:
      transform 180ms var(--gufrau-ease),
      text-shadow 180ms var(--gufrau-ease),
      color 180ms var(--gufrau-ease),
      letter-spacing 180ms var(--gufrau-ease);
  }

  .gufrau-cart-link:hover {
    color: #7a7a7a;
    transform: translateY(-2px) scale(1.04);
    letter-spacing: 0.07em;
    text-shadow:
      0 6px 16px rgba(0, 0, 0, 0.28),
      0 2px 4px rgba(0, 0, 0, 0.14);
  }

  .gufrau-cart-link:active {
    transform: translateY(0) scale(0.97);
    text-shadow: 0 2px 6px rgba(0, 0, 0, 0.16);
  }

  .gufrau-cart-link__label {
    line-height: 1;
  }

  .gufrau-cart-link__count {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    line-height: 1;
  }

  .gufrau-cart-link__count.is-empty {
    opacity: 0.4;
  }
{% endstylesheet %}
