{% comment %}
  Minimal cart link with live item count for GUFRAU pages.
{% endcomment %}

<a
  class="gufrau-cart-link{% if cart.item_count > 0 %} has-items{% endif %}"
  href="{{ routes.cart_url }}"
  data-gufrau-cart-link
  aria-label="Cart{% if cart.item_count > 0 %}, {{ cart.item_count }} items{% endif %}"
>
  <span class="gufrau-cart-link__label">cart</span>
  <span
    class="gufrau-cart-link__count{% if cart.item_count == 0 %} is-empty{% endif %}"
    data-gufrau-cart-count
    aria-hidden="true"
  >
    {{- cart.item_count -}}
  </span>
</a>

{% stylesheet %}
  .gufrau-cart-link {
    --gufrau-ease: cubic-bezier(0.23, 1, 0.32, 1);
    position: fixed;
    top: clamp(1rem, 3vw, 1.75rem);
    right: clamp(1rem, 3vw, 1.75rem);
    z-index: 5;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding: 0.65rem 1.2rem;
    background: #000;
    color: #fff;
    text-decoration: none;
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: lowercase;
    line-height: 1;
    transition:
      transform 180ms var(--gufrau-ease),
      background-color 180ms var(--gufrau-ease),
      color 180ms var(--gufrau-ease);
  }

  .gufrau-cart-link:hover {
    transform: translateY(-2px) scale(1.03);
  }

  .gufrau-cart-link:active {
    transform: translateY(0) scale(0.97);
  }

  .gufrau-cart-link__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.35rem;
    height: 1.35rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: #fff;
    color: #000;
    font-size: 0.78rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
  }

  .gufrau-cart-link__count.is-empty {
    opacity: 0.35;
  }

{% endstylesheet %}

