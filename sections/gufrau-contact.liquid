{% render 'gufrau-contact' %}

{% schema %}
{
  "name": "GUFRAU contact",
  "tag": "div",
  "class": "gufrau-contact-section",
  "settings": [
    {
      "type": "text",
      "id": "booking_label",
      "label": "Booking label",
      "default": "Booking"
    },
    {
      "type": "text",
      "id": "booking_email",
      "label": "Booking email",
      "default": "booking@gufrau.com"
    },
    {
      "type": "text",
      "id": "management_label",
      "label": "Management label",
      "default": "Management"
    },
    {
      "type": "text",
      "id": "management_email",
      "label": "Management email",
      "default": "management@gufrau.com"
    },
    {
      "type": "header",
      "content": "Seller identification (Czech e-shop)"
    },
    {
      "type": "text",
      "id": "seller_label",
      "label": "Seller section label",
      "default": "Provozovatel e-shopu"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Company / trader name"
    },
    {
      "type": "textarea",
      "id": "company_address",
      "label": "Registered address"
    },
    {
      "type": "text",
      "id": "company_ico",
      "label": "IČO"
    },
    {
      "type": "text",
      "id": "company_dic",
      "label": "DIČ"
    },
    {
      "type": "text",
      "id": "shop_email",
      "label": "Shop contact email"
    },
    {
      "type": "text",
      "id": "shop_phone",
      "label": "Shop phone"
    },
    {
      "type": "header",
      "content": "Legal pages"
    },
    {
      "type": "paragraph",
      "content": "Create Shopify pages with handles: obchodni-podminky, reklamacni-rad, odstoupeni-od-smlouvy, ochrana-osobnich-udaju, cookies, mimosoudni-reseni-sporu. Empty page body uses built-in Czech templates."
    },
    {
      "type": "text",
      "id": "legal_label",
      "label": "Legal section label",
      "default": "Právní informace"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0B1F7A"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Bottom logo",
      "info": "Defaults to blueorange.png if empty"
    }
  ],
  "presets": [
    {
      "name": "GUFRAU contact"
    }
  ]
}
{% endschema %}

