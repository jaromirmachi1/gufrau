{% render 'gufrau-contact' %}

{% schema %}
{
  "name": "GUFRAU contact",
  "tag": "div",
  "class": "gufrau-contact-section",
  "settings": [
    {
      "type": "text",
      "id": "booking_label",
      "label": "Booking label",
      "default": "Booking"
    },
    {
      "type": "text",
      "id": "booking_email",
      "label": "Booking email",
      "default": "booking@gufrau.com"
    },
    {
      "type": "text",
      "id": "management_label",
      "label": "Management label",
      "default": "Management"
    },
    {
      "type": "text",
      "id": "management_email",
      "label": "Management email",
      "default": "management@gufrau.com"
    },
    {
      "type": "header",
      "content": "Seller identification (Czech e-shop)"
    },
    {
      "type": "text",
      "id": "seller_label",
      "label": "Seller section label",
      "default": "Provozovatel e-shopu"
    },
    {
      "type": "text",
      "id": "company_name",
      "label": "Company / trader name",
      "default": "GUFRAU s.r.o."
    },
    {
      "type": "textarea",
      "id": "company_address",
      "label": "Registered address",
      "default": "Na Kozačce 1103/5\nVinohrady, 120 00 Praha 2"
    },
    {
      "type": "text",
      "id": "company_ico",
      "label": "IČO",
      "default": "29663075"
    },
    {
      "type": "text",
      "id": "company_dic",
      "label": "DIČ",
      "info": "Leave empty if not a VAT payer"
    },
    {
      "type": "text",
      "id": "shop_email",
      "label": "Shop contact email",
      "default": "management@gufrau.com"
    },
    {
      "type": "text",
      "id": "shop_phone",
      "label": "Shop phone"
    },
    {
      "type": "header",
      "content": "Legal pages"
    },
    {
      "type": "paragraph",
      "content": "Links to Terms of service, Shipping, Refund policy, and Privacy policy (Shopify pages or store policies). Set those pages to Visible."
    },
    {
      "type": "text",
      "id": "legal_label",
      "label": "Legal section label",
      "default": "Legal"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0B1F7A"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Bottom logo",
      "info": "Defaults to blueorange.png if empty"
    }
  ],
  "presets": [
    {
      "name": "GUFRAU contact"
    }
  ]
}
{% endschema %}

