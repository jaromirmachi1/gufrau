{% render 'gufrau-contact' %}

{% schema %}
{
  "name": "GUFRAU contact",
  "tag": "div",
  "class": "gufrau-contact-section",
  "settings": [
    {
      "type": "text",
      "id": "booking_label",
      "label": "Booking label",
      "default": "Booking"
    },
    {
      "type": "text",
      "id": "booking_email",
      "label": "Booking email",
      "default": "booking@gufrau.com"
    },
    {
      "type": "text",
      "id": "management_label",
      "label": "Management label",
      "default": "Management"
    },
    {
      "type": "text",
      "id": "management_email",
      "label": "Management email",
      "default": "management@gufrau.com"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0B1F7A"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Bottom logo",
      "info": "Defaults to blueorange.png if empty"
    }
  ],
  "presets": [
    {
      "name": "GUFRAU contact"
    }
  ]
}
{% endschema %}
