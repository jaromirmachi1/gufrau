{% liquid
  assign logo_image = section.settings.logo
  assign btn_color = section.settings.button_color | default: '#0000FF'
  assign btn_text = section.settings.button_text_color | default: '#FFFFFF'
%}

<section
  class="gufrau-home"
  style="
    --gufrau-btn-bg: {{ btn_color }};
    --gufrau-btn-text: {{ btn_text }};
    --gufrau-page-bg: {{ section.settings.background_color | default: '#FFFFFF' }};
  "
  {{ section.shopify_attributes }}
>
  <nav class="gufrau-home__nav" aria-label="Main navigation">
    {%- for block in section.blocks -%}
      {%- if block.settings.label != blank -%}
        <a
          class="gufrau-home__btn"
          href="{{ block.settings.link | default: '#' }}"
          style="--i: {{ forloop.index0 }}"
          {% if block.settings.open_in_new_tab %}
            target="_blank"
            rel="noopener noreferrer"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          {{ block.settings.label | escape }}
        </a>
      {%- endif -%}
    {%- endfor -%}
  </nav>

  <div class="gufrau-home__logo">
    {%- if logo_image != blank -%}
      {{
        logo_image
        | image_url: width: 2400
        | image_tag:
          class: 'gufrau-home__logo-img',
          widths: '600, 900, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: shop.name
      }}
    {%- else -%}
      <img
        class="gufrau-home__logo-img"
        src="{{ 'gufrau-logo-home.png' | asset_url }}"
        alt="{{ shop.name | escape }}"
        width="2911"
        height="715"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* Force a clean white canvas for this homepage composition */
  body:has(.gufrau-home) {
    background: var(--gufrau-page-bg, #ffffff);
    color: #111;
  }

  body:has(.gufrau-home) #header-group:empty,
  body:has(.gufrau-home) footer:has(.shopify-section-group-footer-group:empty) {
    display: none;
  }

  body:has(.gufrau-home) .content-for-layout {
    display: flex;
    flex-direction: column;
    min-height: 100dvh;
  }

  body:has(.gufrau-home) .content-for-layout > .shopify-section:has(.gufrau-home) {
    flex: 1;
    display: flex;
  }

  .gufrau-home {
    --gufrau-btn-bg: #0000ff;
    --gufrau-btn-text: #ffffff;
    --gufrau-page-bg: #ffffff;
    --gufrau-ease: cubic-bezier(0.23, 1, 0.32, 1);

    flex: 1;
    width: 100%;
    min-height: 100dvh;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: var(--gufrau-page-bg);
    overflow: visible;
    width: 100%;
    isolation: isolate;
  }

  .gufrau-home__nav {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: clamp(0.75rem, 2.2vw, 1.75rem);
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 4vw, 2.5rem);
    pointer-events: none;
    transform: translateY(-20%);
  }

  .gufrau-home__nav .gufrau-home__btn {
    pointer-events: auto;
  }

  .gufrau-home__btn {
    --i: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.75rem;
    padding: 0.7rem 1.55rem;
    border-radius: 999px;
    background: var(--gufrau-btn-bg);
    color: var(--gufrau-btn-text);
    font-family: var(--font-body--family, system-ui, sans-serif);
    font-size: clamp(0.95rem, 1.4vw, 1.125rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1;
    text-decoration: none;
    text-transform: lowercase;
    white-space: nowrap;
    transform: translateZ(0);
    transition:
      transform 180ms var(--gufrau-ease),
      filter 180ms var(--gufrau-ease),
      opacity 180ms var(--gufrau-ease);
    animation: gufrau-btn-in 420ms var(--gufrau-ease) both;
    animation-delay: calc(80ms + var(--i) * 50ms);
  }

  .gufrau-home__btn:hover {
    filter: brightness(1.08);
    transform: scale(1.02);
  }

  .gufrau-home__btn:active {
    transform: scale(0.97);
  }

  .gufrau-home__btn:focus-visible {
    outline: 2px solid var(--gufrau-btn-bg);
    outline-offset: 3px;
  }

  .gufrau-home__logo {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
    pointer-events: none;
    user-select: none;
    line-height: 0;
  }

  .gufrau-home__logo-img {
    transform: translateY(10%);
    display: block;
    width: 104%;
    max-width: none;
    height: auto;
    margin: 0 0 -1% -2%;
    -webkit-mask-image:
      linear-gradient(to right, transparent 0%, #000 2%, #000 98%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, #000 3%, #000 97%, transparent 100%);
    mask-image:
      linear-gradient(to right, transparent 0%, #000 2%, #000 98%, transparent 100%),
      linear-gradient(to bottom, transparent 0%, #000 3%, #000 97%, transparent 100%);
    -webkit-mask-composite: source-in;
    mask-composite: intersect;
  }

  @keyframes gufrau-btn-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.97);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media screen and (max-width: 749px) {
    .gufrau-home__nav {
      gap: 0.65rem 0.75rem;
      padding-inline: 1rem;
    }

    .gufrau-home__btn {
      min-height: 2.5rem;
      padding: 0.65rem 1.2rem;
      font-size: 0.9375rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gufrau-home__btn {
      transition: none;
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GUFRAU home",
  "tag": "div",
  "class": "gufrau-home-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Bottom logo",
      "info": "Defaults to the bundled GUFRAU mark if empty"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#0000FF"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Nav link",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "shop"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_in_new_tab",
          "label": "Open in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "GUFRAU home",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "label": "shows"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "shop"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "contact"
          }
        },
        {
          "type": "link",
          "settings": {
            "label": "discography"
          }
        }
      ]
    }
  ]
}
{% endschema %}
