{% comment %}
  Routes /pages/shop, /pages/shows, /pages/contact, /pages/discography
  to GUFRAU layouts even when the page still uses the default "page" template.
{% endcomment %}

{% liquid
  assign handle = page.handle | downcase
  assign is_legal = false
  if handle == 'terms-of-service' or handle == 'shipping' or handle == 'shipping-policy' or handle == 'refund-policy' or handle == 'privacy-policy' or handle == 'obchodni-podminky' or handle == 'reklamacni-rad' or handle == 'odstoupeni-od-smlouvy' or handle == 'ochrana-osobnich-udaju' or handle == 'cookies' or handle == 'mimosoudni-reseni-sporu'
    assign is_legal = true
  endif
%}

{% case handle %}
  {% when 'shop' %}
    {% render 'gufrau-shop' %}
  {% when 'shows' %}
    {% render 'gufrau-shows' %}
  {% when 'contact' %}
    {% render 'gufrau-contact' %}
  {% when 'discography' %}
    {% render 'gufrau-discography' %}
  {% else %}
    {% if is_legal %}
      {% render 'gufrau-legal' %}
    {% else %}
      <div class="section-background color-{{ section.settings.color_scheme }}"></div>
      <div class="section page-width-content color-{{ section.settings.color_scheme }}">
        <div
          class="spacing-style layout-panel-flex layout-panel-flex--column section-content-wrapper mobile-column"
          style="
            {% render 'layout-panel-style', settings: section.settings %}
            {% render 'spacing-style', settings: section.settings %}
          "
        >
          <h1 class="gufrau-page-fallback__title">{{ page.title | escape }}</h1>
          <div class="rte">{{ page.content }}</div>
        </div>
      </div>
    {% endif %}
{% endcase %}


{% stylesheet %}
  .gufrau-page-fallback__title {
    margin: 0 0 1rem;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "GUFRAU page router",
  "tag": "div",
  "class": "gufrau-page-router",
  "settings": [
    {
      "type": "paragraph",
      "content": "Auto-loads Shop, Shows, Contact, Discography, or legal pages (terms-of-service, shipping, refund-policy, privacy-policy). Other pages show title + content."
    },

    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Fallback color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Fallback gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Fallback padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Fallback padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ]
}
{% endschema %}
