{% render 'gufrau-shows' %}

{% schema %}
{
  "name": "GUFRAU shows",
  "tag": "div",
  "class": "gufrau-shows-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows load from the Concert metaobject (type: concert). Create it in Admin → Content → Metaobjects. Fields: date, city, venue, ticket_url. Enable storefront access."
    },
    {
      "type": "metaobject_list",
      "id": "concerts",
      "label": "Concerts",
      "metaobject_type": "concert",
      "info": "Optional. Leave empty to show all Concert entries automatically."
    },
    {
      "type": "text",
      "id": "ticket_label",
      "label": "Ticket button label",
      "default": "TICKETS"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Defaults to eshpgufrau.jpg if empty"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Bottom logo",
      "info": "Defaults to gfraushows.png if empty"
    }
  ],
  "presets": [
    {
      "name": "GUFRAU shows"
    }
  ]
}
{% endschema %}
