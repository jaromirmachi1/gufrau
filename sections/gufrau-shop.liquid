{% render 'gufrau-shop' %}

{% schema %}
{
  "name": "GUFRAU shop",
  "tag": "div",
  "class": "gufrau-shop-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Defaults to all products if empty"
    },
    {
      "type": "range",
      "id": "products_limit",
      "label": "Max products",
      "min": 4,
      "max": 50,
      "step": 1,
      "default": 24
    },
    {
      "type": "text",
      "id": "buy_label",
      "label": "Buy button label",
      "default": "BUY"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Bottom logo",
      "info": "Defaults to gfraushows.png if empty"
    }
  ],
  "presets": [
    {
      "name": "GUFRAU shop"
    }
  ]
}
{% endschema %}
